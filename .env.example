APP_NAME=KHFinaM
APP_ENV=production
APP_DEBUG=false
# With root .htaccess rewrite (no /public needed):
APP_URL=http://localhost/khfinam
# If pointing DocumentRoot directly at public/ instead, use:
# APP_URL=http://localhost/khfinam/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=khfinam
DB_USER=root
DB_PASS=

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

CSRF_TOKEN_KEY=_csrf_token

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=60

UPLOAD_MAX_MB=10
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,application/pdf

DEFAULT_LOCALE=en
BASE_CURRENCY=MYR

MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=KHFinaM

CRON_KEY=

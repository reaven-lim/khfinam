# Root .htaccess — forwards all requests into public/ transparently.
# Lets you visit http://localhost/khfinam/ instead of http://localhost/khfinam/public/
#
# Requires: AllowOverride All (or FileInfo + Options) in httpd.conf / vhost.
# The public/.htaccess already handles the front-controller rewrite inside public/.
#
# Do NOT short-circuit on %{REQUEST_FILENAME} -d: for /khfinam/ Apache maps that
# to this folder itself, which would skip the rewrite below and expose a directory listing.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
